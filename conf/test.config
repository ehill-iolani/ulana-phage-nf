params {
    // tests/data/ holds the first 1,113 reads (2.5 Mb) of a public T7 run:
    // SRA SRR30401542 (BioProject PRJNA607328, Escherichia phage T7
    // FELIX_MS570, MinION). About 35x after chopper, enough for Flye to give
    // one ~38.6 kb contig whose closest INPHARED phage is T7 (NC_001604).
    // Below 150x, so DOWNSAMPLE_PLAN keeps every read
    input = 'tests/data/samplesheet.csv'

    // every step stays on, Pharokka and CheckV included: their databases are
    // fetched once into assets/db_cache (2.3 GB download) and reused after
    // that. CI adds -stub-run, which skips the databases and has Pharokka and
    // CheckV copy in tests/data/stub/ (this dataset's real outputs) instead
    enable_medaka   = true
    enable_bandage  = true
    enable_pharokka = true
    enable_checkv   = true
}

process {
    // GitHub Actions' ubuntu-latest runners have 4 CPUs / 16GB RAM total --
    // process_high (FLYE_ASSEMBLY) alone requests 8 CPUs, and Nextflow's
    // local executor errors out immediately if a task requests more CPUs
    // than the machine has, so every label needs capping down to what the
    // runner can give it. CheckV peaked at 3.1 GB on a 90 kb phage
    resourceLimits = [ cpus: 4, memory: 6.GB, time: 1.h ]
}
